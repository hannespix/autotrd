# Nicht-geheime Functions-Konfiguration (wird mit deployt — KEINE Secrets!
# Secrets gehören in firebase functions:secrets, lokal in .secret.local).

# App-Check-Enforcement (M7): erst auf 1 stellen, NACHDEM App Check in der
# Firebase-Konsole eingerichtet ist und das Frontend mit
# VITE_FIREBASE_APPCHECK_SITE_KEY deployt wurde — sonst sperrt man alle
# Clients aus. Siehe docs/SETUP.md §I.
APPCHECK_ENFORCE=0
