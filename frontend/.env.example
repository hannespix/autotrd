# → nach frontend/.env.local kopieren und Werte aus der Firebase-Konsole
#   (Projekteinstellungen → Meine Apps → Web-App) eintragen.
#   Die Web-Config ist öffentlich, .env.local bleibt trotzdem ungetrackt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=autotrd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=autotrd
VITE_FIREBASE_APP_ID=
# =1 → Frontend spricht die lokale Emulator-Suite an (firebase emulators:start);
#      dann reichen Dummy-Werte oben (z. B. demo-key / demo-autotrd).
VITE_FIREBASE_USE_EMULATORS=0
