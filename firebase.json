{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": ["npm run build --workspace functions"],
      "ignore": ["node_modules", ".git", "**/*.log", "src", "tsconfig.json"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
