# autotrd — Beispiel-Umgebung. NIE mit echten Werten committen!
#
# Referenz-Python (lokal): nach ~/.hermes/.env kopieren.
# Zielsystem (TS): Secrets leben in GitHub Secrets / Firebase Secret Manager,
# das Frontend bekommt NUR die öffentlichen VITE_FIREBASE_*-Werte.

# ── Frontend (frontend/.env.local — Firebase-Web-Config, öffentlich) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=autotrd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=autotrd
VITE_FIREBASE_APP_ID=
# App Check (M7, optional): reCAPTCHA-v3-Site-Key aus der Firebase-Konsole —
# leer lassen, solange App Check nicht eingerichtet ist (dann No-Op).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ── Functions / Referenz-Python (serverseitig, geheim) ───────────────
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Echtgeld-Doppel-Guard: nur zusammen mit broker.mode=live wirksam (M8)
ALPACA_ALLOW_LIVE=0
