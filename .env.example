# autotrd — Umgebungsvariablen. Nach .env kopieren, NIE committen.

# Alpaca-Keys. Paper-Keys beginnen mit "PK", Live-Keys mit "AK".
# Paper-Keys funktionieren nur gegen paper-api, Live-Keys nur gegen api.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Echtgeld-Doppel-Guard: Echtgeld nur, wenn config broker.mode=live UND hier 1
# UND ein Live-Key (AK…) eingetragen ist. Fehlt eines davon ⇒ Paper.
ALPACA_ALLOW_LIVE=0

# Optional: Telegram-Benachrichtigung (Fills, Halts, Fehler)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Ablageort für State/Journal/Bars-Cache (Default: ./var)
# AUTOTRD_HOME=/var/lib/autotrd
