rules_version = '2';

// autotrd — Security Rules (siehe ARCHITECTURE.md §5)
// Grundsatz: Geteilte Marktdaten liest jeder Eingeloggte, schreibt NUR der
// Server (Admin SDK umgeht Rules). User-Daten sind strikt privat; alles
// Geld-Relevante (wallet/positions/trades) ist auch für den Owner read-only —
// Schreiben ausschließlich über Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Katalog: öffentlich lesbar (auch für Landing Page) ──
    match /meta/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Geteilte Marktdaten: nur eingeloggt lesbar, nie client-schreibbar ──
    match /market/{doc=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── User-Bereich ──
    match /users/{uid} {
      /**
       * Welche settings-Unterfelder der Client SELBST setzen darf.
       *
       * Alles hier drin sind reine Präferenzen ohne Handelswirkung:
       *   ui        Layout, Themes, eingeblendete Module
       *   autoTune  An/Aus-Schalter des Auto-Tuners (nur `=== false` geprüft)
       *   hotkeys   Tastenkürzel
       *
       * `strategy` steht bewusst NICHT dabei — sie muss über `saveStrategy`
       * laufen. Das Callable prüft fünf Dinge, die es sonst nirgends gibt:
       * Schema (validateStrategy), Watchlist-Länge (MAX_WATCHLIST), nur
       * Katalog-Symbole, `broker.mode` bleibt paper, und die Engine startet
       * nur mit bestätigter E-Mail. Ein direkter Schreibzugriff auf
       * `settings.strategy` umging alle fünf.
       *
       * Die Risiko-Hülle (clampStrategyRisk) und das Echtgeld-Doppelschloss
       * (ALPACA_ALLOW_LIVE + Live-Reife) fangen die gefährlichsten Folgen
       * ohnehin ab — aber nicht die E-Mail-Bremse und nicht die
       * Watchlist-Länge: Der Scan liest `settings.strategy.watchlist` roh
       * und stellt sie im Symbol-Kontingent VOR Ranking und Katalog. Eine
       * überlange Watchlist verdrängt damit die Symbole aller anderen.
       */
      function nurPraeferenzen() {
        return request.resource.data.settings
                 .diff(resource.data.get('settings', {}))
                 .affectedKeys()
                 .hasOnly(['ui', 'autoTune', 'hotkeys']);
      }

      allow read: if isOwner(uid);
      allow create: if false;   // Profil legt die Onboarding-Function an
      // User darf NUR das settings-Feld ändern (wallet/profile bleiben
      // serverseitig) — und davon nur die Präferenz-Unterfelder.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['settings'])
        && nurPraeferenzen();
      allow delete: if false;

      // Geld-relevant: read-only für den Owner, Schreiben nur via Functions
      match /positions/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /trades/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      // Archiv (04.08.): Wohin resetWallet die Historie verschiebt, statt sie
      // zu löschen. Dieselben Rechte wie `trades` — es sind dieselben Daten,
      // nur an anderer Stelle. Der Steuer-Export liest beide, damit ein Reset
      // keine Anschaffungskurse verschwinden lässt.
      match /tradesArchive/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Broker-Zugangsdaten (04.08.): für ALLE gesperrt, auch für den Owner
      // selbst — hier liegen Alpaca-Schlüssel. Nur das Admin-SDK der
      // Functions liest sie. Der Nutzer setzt sie über `connectBroker` und
      // bekommt sie nie zurück; die App zeigt ausschließlich eine maskierte
      // Kennung. Ein Lesezugriff wäre der eine Weg, auf dem ein übernommenes
      // Konto den Schlüssel abgreifen könnte.
      match /private/{doc} {
        allow read, write: if false;
      }

      // Regelbaum-Strategien: read-only für den Owner — Schreiben NUR über
      // die Callables saveStrategyDraft/publishStrategyVersion/assignStrategy
      match /strategies/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
        // Backtest-Reports (M11): schreibt nur runBacktest (Admin SDK)
        match /runs/{runId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        // Shadow-Signale (M11): schreibt nur der Scan bei Richtungs-Wechsel
        match /shadowSignals/{sigId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // User-Prognosen (Chart-Pfeile): steuern Trades → nur savePrediction
      match /predictions/{sym} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Portfolio (M12): Equity-Kurve + Kennzahlen — schreibt nur snapshotEquity
      match /equity/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /stats/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Auto-Tuner (MT): Schattenkonten der Varianten und das Änderungs-
      // Journal. Beides schreibt AUSSCHLIESSLICH der Server — ein Client, der
      // sein eigenes Journal schreiben dürfte, könnte eine Beförderung
      // erfinden, und die Nachvollziehbarkeit wäre wertlos.
      match /tuning/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /tuneLog/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Trade-Journal (M12): Die FAKTEN (Symbol, Menge, P&L, Signal-Kontext)
      // legt ausschliesslich der Server bei der Buchung an. Der Client darf
      // GENAU seine vier Review-Felder aendern — ein Journal, dessen Fakten
      // der User editieren kann, waere als Lernwerkzeug wertlos, und ein
      // frei erfindbarer Eintrag genauso.
      match /journal/{doc} {
        allow read: if isOwner(uid);
        allow create, delete: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['notes', 'tags', 'mistakes', 'review']);
      }

      // Alerts: gehören dem User komplett
      match /alerts/{doc} {
        allow read, write: if isOwner(uid);
      }

      // Workspaces (M9): Layout/Link-Gruppen — rein clientseitige Präferenzen
      match /workspaces/{doc} {
        allow read, write: if isOwner(uid);
      }

      // Loadouts (MU4): benannte Einstellungs-Schnappschüsse des Nutzers.
      // Client-schreibbar wie Workspaces — es sind reine Präferenz-KOPIEN;
      // wirksam wird ein Loadout erst über saveStrategy und damit durch
      // dieselbe Server-Validierung wie jede Handeingabe.
      match /loadouts/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Quotas/Admin: rein serverseitig ──
    match /admin/{doc=**} {
      allow read, write: if false;
    }

    // Default-Deny für alles Unerwähnte
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
